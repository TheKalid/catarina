# Base URL of the Catarina backend API.
# The backend serves its OpenAPI spec at ${NEXT_PUBLIC_API_BASE_URL}/docs/json.
# The Next dev server runs on :3001 to avoid clashing with the backend on :3000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Spec URL used by `npm run gen:api` (defaults to the backend's /docs/json).
# API_SPEC_URL=http://localhost:3000/docs/json
